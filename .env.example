# Optional, not required. claude-agent-sdk shells out to your local `claude`
# CLI and lets it resolve credentials. Set this for pay-as-you-go Console
# billing (console.anthropic.com -> API Keys) and the $ budget cap in
# config/policy.yaml applies for real. Leave it blank/unset entirely to use
# an existing `claude login` (Pro/Max/Team subscription) instead — in that
# mode you're spending your subscription's rate-limited usage window, not
# dollars, and max_budget_usd_per_run has no effect. See README ->
# "Authentication" before choosing.
ANTHROPIC_API_KEY=

# Optional: where agent-os keeps run state, approval queue, and logs.
# Defaults to ./state/ (gitignored) if unset.
AGENTOS_STATE_DIR=

# Optional: repo root agents are allowed to operate in (git ops, file writes).
# Defaults to the current working directory if unset.
AGENTOS_WORKDIR=
