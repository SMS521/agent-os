# Required by claude-agent-sdk / the underlying Claude Code CLI it shells out to.
ANTHROPIC_API_KEY=

# Optional: where agent-os keeps run state, approval queue, and logs.
# Defaults to ./state/ (gitignored) if unset.
AGENTOS_STATE_DIR=

# Optional: repo root agents are allowed to operate in (git ops, file writes).
# Defaults to the current working directory if unset.
AGENTOS_WORKDIR=
